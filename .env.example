# Human Possibility Engine — example environment. Copy to .env for local overrides.
# The entire product (simulator, experiments, dashboard, Future Self) runs WITHOUT any API key.

# Where runtime state (SQLite DB, run logs, checkpoints) is written. Gitignored.
HPE_DATA_DIR=./data

# Directory of committed, real stored experiment outputs used by the offline demo mode.
HPE_REPORTS_DIR=./reports

# API server
HPE_API_HOST=127.0.0.1
HPE_API_PORT=8000
# Comma-separated list of allowed browser origins for the web app.
HPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hard limits for expensive operations requested through the API.
HPE_MAX_AGENTS_PER_RUN=2000
HPE_MAX_YEARS_PER_RUN=100
HPE_MAX_CONCURRENT_JOBS=2

# Optional external language model for *narration only* (Tier 3). Disabled by default.
# Never used for ground truth, probabilities, or developmental competence.
HPE_LLM_PROVIDER=none          # none | mock | anthropic
HPE_LLM_MAX_CALLS_PER_HOUR=0
# ANTHROPIC_API_KEY=             # set only in your local .env; never commit

# Web app: base URL of the API
VITE_API_BASE_URL=http://127.0.0.1:8000
