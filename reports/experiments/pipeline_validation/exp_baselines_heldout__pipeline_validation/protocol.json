    {
      "name": "memory_only_vs_static_persona",
      "treatment": "memory_only",
      "control": "static_persona",
      "metric": "final_heldout_accuracy",
      "kind": "exploratory",
      "paired": true,
      "direction": "greater",
      "min_effect": null,
